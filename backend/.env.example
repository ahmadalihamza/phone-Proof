APP_ENV=development
DATABASE_URL=sqlite:///./runtime/phoneproof.db
PUBLIC_REPORT_BASE_URL=http://localhost:8000
TRIAL_ENABLED=true
TRIAL_REPORT_LIMIT=1
TRIAL_DURATION_DAYS=14
DEVELOPMENT_PAYMENTS=false
REQUIRE_COSMETIC=true
HEALTHCHECK_HOST=
READINESS_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=50
# Email actions are unavailable until both SMTP_HOST and SMTP_FROM are set.
# Run the mail outbox worker separately; the API only queues encrypted messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_IMPLICIT_TLS=false
# SMTP uses STARTTLS by default; implicit TLS normally uses port 465.
# Production: inject a stable, secret 64-hex-character key (also encrypts mail).
MFA_ENCRYPTION_KEY=
# For two physical phones, set PUBLIC_REPORT_BASE_URL to the computer's LAN URL.
# Android API URL should be http://COMPUTER_LAN_IP:8000/api/v1/ in debug builds.
