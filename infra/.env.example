APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-generated-password
JWT_SECRET=replace-with-at-least-48-random-characters-before-hosting
PUBLIC_REPORT_BASE_URL=http://localhost:8000
DEVELOPMENT_PAYMENTS=false
TRIAL_REPORT_LIMIT=1
TRIAL_DURATION_DAYS=14
REQUIRE_COSMETIC=true
SIGNING_KEY_PATH=./runtime/report-signing.pem
SIGNING_KEY_VERSION=v1
MFA_ENCRYPTION_KEY=
# Optional specific Host header for the loopback /ready probe. It must match
# ALLOWED_HOSTS; empty selects the allowed public hostname or first named host.
HEALTHCHECK_HOST=
READINESS_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=50
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_IMPLICIT_TLS=false
# Production: set APP_ENV=production, HTTPS public origin, approved hosts, private S3,
# a pre-provisioned Ed25519 signing key, a stable 64-hex-character MFA_ENCRYPTION_KEY,
# and secrets injected by the hosting provider. Enable profile mail only with SMTP.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# ALLOWED_HOSTS=api.example.com,verify.example.com
# Readiness writes, reads and deletes small objects under healthcheck/. Include
# that prefix in the private bucket's application permissions/lifecycle policy.
# MODEL_MANIFEST=/models/manifest.json
